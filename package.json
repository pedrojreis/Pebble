{
	"name": "obsidian-pebble",
	"version": "1.0.12",
	"description": "A minimal companion for quick note-taking — lives in your menu bar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "0.5.1",
		"globals": "17.14.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"tslib": "2.9.1",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1",
		"vitest": "^5.1.0"
	}
}
