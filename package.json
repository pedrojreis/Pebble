{
	"name": "obsidian-pebble",
	"version": "1.0.11",
	"description": "A minimal companion for quick note-taking — lives in your menu bar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^26.2.0",
		"esbuild": "0.28.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.10.0",
		"jiti": "2.6.1",
		"obsidian": "^1.13.1",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.67.0",
		"vitest": "^4.1.10"
	}
}
